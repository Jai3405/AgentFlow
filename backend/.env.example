# ============================================
# AgentFlow Environment Configuration
# ============================================

# ----------------
# AI/LLM Services
# ----------------

# Gemini API (Primary - Required for conversation management)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional - Legacy support)
OPENAI_API_KEY=your_openai_api_key_here

# ----------------
# Database
# ----------------

# Database URL (SQLite for development, PostgreSQL/MySQL for production)
DATABASE_URL=sqlite:///./agentflow.db
# PostgreSQL example: postgresql://user:password@localhost:5432/agentflow
# MySQL example: mysql://user:password@localhost:3306/agentflow

# ----------------
# Application
# ----------------

# Secret key for sessions and encryption
SECRET_KEY=your_secret_key_here_change_in_production

# CORS origins (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000"]

# Debug mode
DEBUG=True

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ----------------
# Email Integration (Phase 3)
# ----------------

# Gmail API OAuth2
GMAIL_TOKEN_FILE=token.json
GMAIL_CREDENTIALS_FILE=credentials.json

# Outlook/Microsoft Graph API
OUTLOOK_CLIENT_ID=your_azure_ad_client_id
OUTLOOK_CLIENT_SECRET=your_azure_ad_client_secret
OUTLOOK_TENANT_ID=your_azure_ad_tenant_id

# ----------------
# Notification Services (Phase 3)
# ----------------

# Slack Bot Token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# SMTP Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_ADDRESS=your_email@gmail.com

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ----------------
# Database Connectors (Phase 3)
# ----------------

# PostgreSQL External
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=external_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# MySQL External
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=external_db
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# MongoDB
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/external_db
# Or component-wise:
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=external_db
MONGODB_USER=user
MONGODB_PASSWORD=password

# ----------------
# Webhook Configuration (Phase 3)
# ----------------

# Webhook security (optional)
WEBHOOK_SECRET=your_webhook_secret_for_hmac_signing

# ----------------
# Execution & Scheduling (Phase 4)
# ----------------

# Scheduler settings
SCHEDULER_ENABLED=True
SCHEDULER_CHECK_INTERVAL=1  # seconds

# Execution timeouts
DEFAULT_STEP_TIMEOUT=300  # seconds
DEFAULT_WORKFLOW_TIMEOUT=3600  # seconds

# ----------------
# Optional Services
# ----------------

# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# Redis for caching (optional)
REDIS_URL=redis://localhost:6379/0
